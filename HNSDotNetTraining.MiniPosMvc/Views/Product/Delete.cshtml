@model HNSDotNetTraining.Database2.Models.TblProduct

@{
    ViewData["Title"] = "Delete Product";
}

<h2 class="text-danger">Delete Product</h2>
<p class="lead">Are you sure you want to delete this product?</p>
<hr />

<div class="card col-md-6 border-danger">
    <div class="card-body">
        <dl class="row mb-0">
            @* <dt class="col-sm-4">Product ID</dt>
            <dd class="col-sm-8">@Model.ProductId</dd> *@

            <dt class="col-sm-4">Product Code</dt>
            <dd class="col-sm-8">@Model.ProductCode</dd>

            <dt class="col-sm-4">Product Name</dt>
            <dd class="col-sm-8">@Model.ProductName</dd>

            <dt class="col-sm-4">Price</dt>
            <dd class="col-sm-8">@Model.Price.ToString("N0")</dd>

            <dt class="col-sm-4">Quantity</dt>
            <dd class="col-sm-8">@Model.Quantity</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="ProductId" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

