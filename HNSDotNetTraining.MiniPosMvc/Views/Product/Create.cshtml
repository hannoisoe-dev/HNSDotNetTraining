@model HNSDotNetTraining.Database2.Models.TblProduct

@{
    ViewData["Title"] = "Create Product";
}

<h2>Create Product</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <!-- Display all validation and database errors -->
            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>

            <!-- Product Name -->
            <div class="mb-3">
                <label asp-for="ProductName" class="form-label">
                    Product Name
                </label>

                <input asp-for="ProductName"
                       class="form-control"
                       placeholder="e.g. Coffee" />

                <span asp-validation-for="ProductName"
                      class="text-danger">
                </span>
            </div>

            <!-- Price -->
            <div class="mb-3">
                <label asp-for="Price" class="form-label">
                    Price
                </label>

                <input asp-for="Price"
                       type="number"
                       step="any"
                       class="form-control"
                       placeholder="0" />

                <span asp-validation-for="Price"
                      class="text-danger">
                </span>
            </div>

            <!-- Quantity -->
            <div class="mb-3">
                <label asp-for="Quantity" class="form-label">
                    Quantity
                </label>

                <input asp-for="Quantity"
                       type="number"
                       class="form-control"
                       placeholder="0" />

                <span asp-validation-for="Quantity"
                      class="text-danger">
                </span>
            </div>

            <!-- Buttons -->
            <button type="submit" class="btn btn-primary">
                Save
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Back to List
            </a>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
